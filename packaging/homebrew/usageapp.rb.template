# Rendered by .github/workflows/macos.yml for each release and pushed to the Homebrew tap.
cask "usageapp" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/@REPOSITORY@/releases/download/v#{version}/UsageApp-macos-universal.zip"
  name "UsageApp"
  desc "Claude Code, Codex, and Perplexity allowance rings at the edge of the display"
  homepage "https://github.com/@REPOSITORY@"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on macos: ">= :sonoma"

  app "UsageApp.app"

  uninstall quit: "org.usageapp.macos"

  # The guided Claude Code helper lives in Application Support. Undo Setup first so the status line keeps working.
  zap trash: [
    "~/Library/Application Support/UsageApp",
    "~/Library/Preferences/org.usageapp.macos.plist",
  ]

  caveats <<~EOS
    If you connected Claude Code, choose Settings → Claude Code → Undo Setup
    before running `brew uninstall --zap usageapp`, so your original status line is restored.
  EOS
end
